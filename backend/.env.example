NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eduverse
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3001
PORT=3000
BCRYPT_ROUNDS=12
THROTTLE_TTL=60000
THROTTLE_LIMIT=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

# Enable only for the one-time initial platform-admin bootstrap, then disable it.
BOOTSTRAP_SUPER_ADMIN=false
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=

CLOUDINARY_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

AI_API_KEY=
AI_API_BASE_URL=
AI_APP_URL=
AI_APP_NAME=EduVerse
AI_MODEL=
AI_TEMPERATURE=0.2
AI_MAX_RETRIES=2
AI_COST_PER_1K_TOKENS=0

LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_AI_ORG_STARTER_VARIANT_ID=
LEMON_SQUEEZY_AI_ORG_GROWTH_VARIANT_ID=
LEMON_SQUEEZY_AI_ORG_SCALE_VARIANT_ID=
LEMON_SQUEEZY_AI_PERSONAL_STARTER_VARIANT_ID=
LEMON_SQUEEZY_AI_PERSONAL_GROWTH_VARIANT_ID=
LEMON_SQUEEZY_AI_PERSONAL_SCALE_VARIANT_ID=

