# Environment Variables for DB, JWT, and Frontend URL
# Currently using deployment database URL
DATABASE_URL=
JWT_SECRET=
# Separate HMAC secret for expiring CAPTCHA answers and privacy-preserving IP hashes.
# Use a long random value; JWT_SECRET is used only as a backward-compatible fallback.
HUMAN_VERIFICATION_SECRET=
FRONTEND_URL=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=none

# Google Auth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Super Admin Credentials
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# Cloudinary Configuration for Media Storage
CLOUDINARY_URL=

# App Settings
PORT=3000
BCRYPT_ROUNDS=10

# API Security (Rate Limiting)
THROTTLE_TTL=60000
THROTTLE_LIMIT=150

# VAPID Keys for Web Push Notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Resend API Key for Email Notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# super admin email
SUPER_ADMIN_EMAIL=

# Billing (Lemon Squeezy) Configuration
LEMON_SQUEEZY_SECRET_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Lemon Squeezy Variant IDs for AI Features
LEMON_SQUEEZY_AI_ORG_STARTER_VARIANT_ID=...
LEMON_SQUEEZY_AI_ORG_GROWTH_VARIANT_ID=...
LEMON_SQUEEZY_AI_ORG_SCALE_VARIANT_ID=...
LEMON_SQUEEZY_AI_PERSONAL_STARTER_VARIANT_ID=...
LEMON_SQUEEZY_AI_PERSONAL_GROWTH_VARIANT_ID=...
LEMON_SQUEEZY_AI_PERSONAL_SCALE_VARIANT_ID=...

# AI API Key for AI Features. Use an OpenRouter key here.
AI_API_KEY=
AI_API_BASE_URL=
AI_APP_URL=
AI_APP_NAME=
AI_MODEL=
AI_TEMPERATURE=0.2
AI_MAX_RETRIES=2

# AI providers and langchain settings
AI_COST_PER_1K_TOKENS=

# Lemon Squeezy Webhook URL for handling events
# POST http://localhost:3000/ai/billing/webhook
