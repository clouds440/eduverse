  orgId                     String
  entityType                String
  entityId                  String
  path                      String
  publicId                  String?
  filename                  String
  mimeType                  String
  size                      Int
  uploadedBy                String
  resourceType              String                     @default("raw")
  deliveryType              String                     @default("authenticated")
  fileKind                  String                     @default("document")
  extension                 String?
