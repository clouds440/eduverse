  scanStatus                String                     @default("PASSED")
  lockedAt                  DateTime?
  lockedByArchiveId         String?
  createdAt                 DateTime                   @default(now())
  gradeAnswerbookAttachment GradeAnswerbookAttachment?
  lockedByArchive           AcademicCycleArchive?      @relation(fields: [lockedByArchiveId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
