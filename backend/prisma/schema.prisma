  id                         String                  @id @default(uuid())
  ownerType                  AISubscriptionOwnerType
  organizationId             String?
  userId                     String?
  plan                       AISubscriptionPlan      @default(NONE)
  status                     AISubscriptionStatus    @default(INACTIVE)
  monthlyCredits             Int                     @default(0)
  limitMode                  AILimitMode             @default(HARD)
  currentPeriodStart         DateTime?
  currentPeriodEnd           DateTime?
  lemonSqueezyCustomerId     String?
  lemonSqueezySubscriptionId String?
  lemonSqueezyVariantId      String?
  lemonSqueezyPortalUrl      String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  organization  Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  usages        AIUsage[]
  toolCallLogs  AIToolCallLog[]
  conversations AIConversation[]

  @@unique([ownerType, organizationId])
  @@unique([ownerType, userId])
  @@index([ownerType])
  @@index([plan])
  @@index([status])
  @@index([lemonSqueezyCustomerId])
  @@index([lemonSqueezySubscriptionId])
  @@index([organizationId])
  @@index([userId])
  @@index([currentPeriodEnd])
}

model AIOrgAccessPolicy {
  id                   String   @id @default(uuid())
  organizationId       String   @unique
  allowSubAdmins       Boolean  @default(false)
  allowManagers        Boolean  @default(false)
  allowFinanceManagers Boolean  @default(false)
  allowTeachers        Boolean  @default(false)
  allowStudents        Boolean  @default(false)
  allowGuardians       Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AIRoleCreditPolicy {
  id             String   @id @default(uuid())
  organizationId String
  role           Role
  monthlyCredits Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role])
  @@index([organizationId])
  @@index([role])
}

model AIUsage {
  id                    String            @id @default(uuid())
  subscriptionId        String
  sourceType            AIUsageSourceType
  organizationId        String?
  userId                String
  role                  Role?
  periodStart           DateTime
  periodEnd             DateTime
  creditUsed            Int               @default(0)
  providerTokenEstimate Int               @default(0)
  estimatedCost         Decimal           @default(0.00) @db.Decimal(12, 4)
  overageCredits        Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  subscription AISubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, userId, periodStart])
  @@index([subscriptionId])
  @@index([sourceType])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
  @@index([periodStart])
  @@index([periodEnd])
}

model AIToolCallLog {
  id                    String             @id @default(uuid())
  userId                String?
  orgId                 String?
  subscriptionId        String?
  sourceType            AIUsageSourceType?
  toolName              String
  allowed               Boolean
  latencyMs             Int
  creditEstimate        Int?
  providerTokenEstimate Int?
  createdAt             DateTime           @default(now())

  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription AISubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orgId])
  @@index([subscriptionId])
  @@index([sourceType])
  @@index([toolName])
  @@index([allowed])
  @@index([createdAt])
}

model AIConversation {
  id             String    @id @default(uuid())
  userId         String
  organizationId String?
  subscriptionId String?
  title          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  expiresAt      DateTime?

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription AISubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  messages     AIMessage[]

  @@index([userId])
  @@index([organizationId])
  @@index([subscriptionId])
  @@index([expiresAt])
  @@index([updatedAt])
}

model AIMessage {
  id             String        @id @default(uuid())
  conversationId String
  role           AIMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
  @@index([createdAt])
}

enum AcademicEventType {
  HOLIDAY
  EXAM_BREAK
  EVENT
  CLOSURE

  @@map("HolidayType")
}

enum AcademicEventMatchMode {
  SINGLE_DAY
  DATE_RANGE
  WEEKDAYS_IN_RANGE
  DAILY_IN_RANGE

  @@map("HolidayMatchMode")
}

model Announcement {
  id              String               @id @default(uuid())
  title           String
  body            String // Markdown
  targetType      TargetType
  targetId        String? // e.g. orgId, role name, or sectionId
  actionUrl       String?
  bannerUrl       String?
  bannerFileId    String?
  bannerFilename  String?
  bannerMimeType  String?
  bannerUpdatedAt DateTime?
  priority        AnnouncementPriority @default(NORMAL)
  creatorId       String
  organizationId  String? // Scope to org if applicable
  createdAt       DateTime             @default(now())

  creator           User               @relation("CreatedAnnouncements", fields: [creatorId], references: [id])
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  preferenceWindows PreferenceWindow[]

  @@index([organizationId])
  @@index([targetType, targetId])
}

enum PreferenceWindowKind {
  SECTION_CHOICE
  COURSE_CHOICE
}

enum PreferenceWindowStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum PreferenceTargetType {
  COURSE
  COHORT
  SECTION
}

model PreferenceWindow {
  id              String                 @id @default(uuid())
  organizationId  String
  academicCycleId String
  title           String
  description     String?
  kind            PreferenceWindowKind
  status          PreferenceWindowStatus @default(DRAFT)
  startAt         DateTime
  endAt           DateTime
  announcementId  String?
  createdById     String
  updatedById     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization  Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicCycle AcademicCycle              @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  announcement  Announcement?              @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  createdBy     User                       @relation("CreatedPreferenceWindows", fields: [createdById], references: [id])
  updatedBy     User?                      @relation("UpdatedPreferenceWindows", fields: [updatedById], references: [id])
  options       PreferenceWindowOption[]
  audiences     PreferenceWindowAudience[]
  submissions   PreferenceSubmission[]

  @@index([organizationId])
  @@index([academicCycleId])
  @@index([kind])
  @@index([status])
  @@index([startAt, endAt])
  @@index([announcementId])
}

model PreferenceWindowOption {
  id           String               @id @default(uuid())
  windowId     String
  targetType   PreferenceTargetType
  courseId     String?
  sectionId    String?
  displayOrder Int                  @default(0)

  window  PreferenceWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  course  Course?          @relation("PreferenceOptionCourse", fields: [courseId], references: [id], onDelete: Cascade)
  section Section?         @relation("PreferenceOptionSection", fields: [sectionId], references: [id], onDelete: Cascade)
  ranks   PreferenceRank[]

  @@unique([windowId, courseId])
  @@unique([windowId, sectionId])
  @@index([windowId])
  @@index([courseId])
  @@index([sectionId])
}

model PreferenceWindowAudience {
  id         String               @id @default(uuid())
  windowId   String
  targetType PreferenceTargetType
  courseId   String?
  cohortId   String?
  sectionId  String?

  window  PreferenceWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  course  Course?          @relation("PreferenceAudienceCourse", fields: [courseId], references: [id], onDelete: Cascade)
  cohort  Cohort?          @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  section Section?         @relation("PreferenceAudienceSection", fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([windowId, courseId])
  @@unique([windowId, cohortId])
  @@unique([windowId, sectionId])
  @@index([windowId])
  @@index([courseId])
  @@index([cohortId])
  @@index([sectionId])
}

model PreferenceSubmission {
  id            String   @id @default(uuid())
  windowId      String
  studentId     String
  submittedById String
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  window      PreferenceWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedBy User             @relation("PreferenceSubmissionUsers", fields: [submittedById], references: [id])
  ranks       PreferenceRank[]

  @@unique([windowId, studentId])
  @@index([windowId])
  @@index([studentId])
  @@index([submittedById])
}

model PreferenceRank {
  id           String @id @default(uuid())
  submissionId String
  optionId     String
  rank         Int

  submission PreferenceSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  option     PreferenceWindowOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, optionId])
  @@unique([submissionId, rank])
  @@index([optionId])
}

// ─── TIMETABLE & ATTENDANCE SYSTEM ──────────────────────────────────────────

model AcademicEvent {
  id                  String                 @id @default(uuid())
  organizationId      String
  title               String
  description         String?
  type                AcademicEventType      @default(HOLIDAY)
  matchMode           AcademicEventMatchMode @default(SINGLE_DAY)
  departmentScopeType DepartmentScopeType    @default(ALL)
  startDate           DateTime
  endDate             DateTime
  startTime           String?
  endTime             String?
  daysOfWeek          Int[]                  @default([])
  bannerUrl           String?
  bannerFileId        String?
  bannerFilename      String?
  bannerMimeType      String?
  bannerUpdatedAt     DateTime?
  isFullDay           Boolean                @default(true)
  isActive            Boolean                @default(true)
  createdById         String
  updatedById         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                      @relation("CreatedAcademicEvents", fields: [createdById], references: [id])
  updatedBy       User?                     @relation("UpdatedAcademicEvents", fields: [updatedById], references: [id])
  departmentLinks AcademicEventDepartment[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, startDate, endDate])
  @@index([type])
  @@index([matchMode])
  @@map("Holiday")
}

model AcademicEventDepartment {
  academicEventId String   @map("holidayId")
  departmentId    String
  assignedAt      DateTime @default(now())

  academicEvent AcademicEvent @relation(fields: [academicEventId], references: [id], onDelete: Cascade)
  department    Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([academicEventId, departmentId])
  @@index([departmentId])
  @@map("HolidayDepartment")
}

model EvaluationWindow {
  id              String   @id @default(uuid())
  organizationId  String
  academicCycleId String
  courseId        String?
  sectionId       String?
  title           String
  description     String?
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean  @default(true)
  createdById     String
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicCycle AcademicCycle @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  course        Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section       Section?      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("CreatedEvaluationWindows", fields: [createdById], references: [id])
  updatedBy     User?         @relation("UpdatedEvaluationWindows", fields: [updatedById], references: [id])
  evaluations   Evaluation[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([academicCycleId])
  @@index([courseId])
  @@index([sectionId])
  @@index([startDate, endDate])
}

model Evaluation {
  id              String         @id @default(uuid())
  organizationId  String
  type            EvaluationType
  studentId       String
  sectionId       String
  courseId        String
  teacherId       String?
  academicCycleId String
  windowId        String?
  rating          Int
  feedback        String?
  isHidden        Boolean        @default(false)
  hiddenById      String?
  hiddenAt        DateTime?
  hiddenReason    String?
  createdById     String
  updatedById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student       Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section       Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  course        Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher       Teacher?          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicCycle AcademicCycle     @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  window        EvaluationWindow? @relation(fields: [windowId], references: [id], onDelete: SetNull)
  createdBy     User              @relation("CreatedEvaluations", fields: [createdById], references: [id])
  updatedBy     User?             @relation("UpdatedEvaluations", fields: [updatedById], references: [id])
  hiddenBy      User?             @relation("HiddenEvaluations", fields: [hiddenById], references: [id])

  @@index([organizationId])
  @@index([type])
  @@index([studentId])
  @@index([teacherId])
  @@index([courseId])
  @@index([sectionId])
  @@index([academicCycleId])
  @@index([windowId])
  @@index([isHidden])
}

model SectionSchedule {
  id              String @id @default(uuid())
  sectionId       String
  academicCycleId String

  day       Int // 0 = Sunday, 1 = Monday ... 6 = Saturday
  date      DateTime?
  type      ScheduleType @default(OFFICIAL)
  startTime String // "09:00"
  endTime   String // "10:00"

  room      String? // optional override
  roomId    String?
  teacherId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section       Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  roomRef       Room?         @relation("ScheduleRoom", fields: [roomId], references: [id], onDelete: SetNull)
  teacher       Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicCycle AcademicCycle @relation(fields: [academicCycleId], references: [id], onDelete: Restrict)

  attendanceSessions AttendanceSession[]

  @@index([sectionId])
  @@index([day])
  @@index([date])
  @@index([type])
  @@index([academicCycleId])
  @@index([roomId])
  @@index([teacherId])
}

model AttendanceSession {
  id              String   @id @default(uuid())
  sectionId       String
  scheduleId      String
  academicCycleId String
  date            DateTime
  startTime       String?
  endTime         String?

  createdAt DateTime @default(now())

  section       Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  schedule      SectionSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  academicCycle AcademicCycle      @relation(fields: [academicCycleId], references: [id], onDelete: Restrict)
  records       AttendanceRecord[]

  @@unique([scheduleId, date])
  @@index([sectionId])
  @@index([scheduleId])
  @@index([date])
  @@index([academicCycleId])
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  sessionId String
  studentId String
  status    AttendanceStatus

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ScheduleType {
  OFFICIAL
  AD_HOC
}

// ─── COURSE MATERIALS ────────────────────────────────────────────────────────
model CourseMaterial {
  id              String   @id @default(uuid())
  sectionId       String
  academicCycleId String
  title           String
  description     String?
  links           String[]
  isVideoLink     Boolean  @default(false)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  section       Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicCycle AcademicCycle @relation(fields: [academicCycleId], references: [id], onDelete: Restrict)

  @@index([sectionId])
  @@index([academicCycleId])
}

// ─── ACADEMIC LIFECYCLE SYSTEM ───────────────────────────────────────────────

enum EnrollmentSource {
  MANUAL
  COHORT
}

enum AcademicCycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVING
  ARCHIVED
}

enum ProgramClassificationStatus {
  STANDALONE
  PROGRAM_MAPPED
}

enum CohortLifecycleStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum SectionLifecycleStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum AssessmentLifecycleStatus {
  ACTIVE
  RETIRED
  ARCHIVED
}

model AcademicCycle {
  id                String              @id @default(uuid())
  name              String
  code              String
  startDate         DateTime
  endDate           DateTime
  status            AcademicCycleStatus @default(DRAFT)
  organizationId    String
  gpaPolicyId       String?
  gpaPolicySnapshot Json?
  completedAt       DateTime?
  completedById     String?
  archivedAt        DateTime?
  archivedById      String?
  archiveReason     String?
  currentArchiveId  String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gpaPolicy           GpaPolicy?             @relation(fields: [gpaPolicyId], references: [id], onDelete: SetNull)
  cohorts             Cohort[]
  sections            Section[]
  enrollments         Enrollment[]
  enrollmentHistories EnrollmentHistory[]
  cohortOfferings     CohortOffering[]
  assessments         Assessment[]
  grades              Grade[]
  submissions         Submission[]
  attendanceSessions  AttendanceSession[]
  courseMaterials     CourseMaterial[]
  evaluationWindows   EvaluationWindow[]
  evaluations         Evaluation[]
  sectionSchedules    SectionSchedule[]
  preferenceWindows   PreferenceWindow[]
  programOfferings    ProgramOffering[]
  archives            AcademicCycleArchive[] @relation("AcademicCycleArchives")
  currentArchive      AcademicCycleArchive?  @relation("CurrentAcademicCycleArchive", fields: [currentArchiveId], references: [id], onDelete: Restrict)
  courseResultSchemes CourseResultScheme[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@index([gpaPolicyId])
}

enum CourseResultComponentType {
  THEORY
  LAB
  PRACTICAL
  TUTORIAL
  RECITATION
  CLINIC
  STUDIO
  FIELDWORK
  OTHER
}

model CourseResultScheme {
  id              String   @id @default(uuid())
  organizationId  String
  courseId        String
  academicCycleId String
  name            String   @default("Section Result Relationship")
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  course        Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicCycle AcademicCycle           @relation(fields: [academicCycleId], references: [id], onDelete: Restrict)
  components    CourseResultComponent[]

  @@unique([organizationId, courseId, academicCycleId])
  @@index([organizationId])
  @@index([courseId])
  @@index([academicCycleId])
}

model CourseResultComponent {
  id            String                    @id @default(uuid())
  schemeId      String
  componentType CourseResultComponentType
  label         String
  weight        Float
  sortOrder     Int                       @default(0)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  scheme       CourseResultScheme             @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  sectionLinks CourseResultComponentSection[]

  @@unique([schemeId, componentType])
  @@index([schemeId])
  @@index([componentType])
}

model CourseResultComponentSection {
  id          String   @id @default(uuid())
  componentId String
  sectionId   String
  createdAt   DateTime @default(now())

  component CourseResultComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  section   Section               @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([componentId, sectionId])
  @@index([sectionId])
}

model Cohort {
  id             String                @id @default(uuid())
  name           String
  code           String
  organizationId String
  status         CohortLifecycleStatus @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offerings           CohortOffering[]
  preferenceAudiences PreferenceWindowAudience[]
  academicCycle       AcademicCycle?             @relation(fields: [academicCycleId], references: [id])
  academicCycleId     String?

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
}

model EnrollmentHistory {
  id                         String  @id @default(uuid())
  studentId                  String
  sectionId                  String
  academicCycleId            String
  studentProgramEnrollmentId String?
  studentStageEnrollmentId   String?
  studentCohortMembershipId  String?

  source      EnrollmentSource @default(MANUAL)
  wasExcluded Boolean          @default(false)

  enrolledAt DateTime  @default(now())
  removedAt  DateTime?

  student                  Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section                  Section                   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicCycle            AcademicCycle             @relation(fields: [academicCycleId], references: [id], onDelete: Restrict)
  studentProgramEnrollment StudentProgramEnrollment? @relation(fields: [studentProgramEnrollmentId], references: [id], onDelete: Restrict)
  studentStageEnrollment   StudentStageEnrollment?   @relation(fields: [studentStageEnrollmentId], references: [id], onDelete: Restrict)
  studentCohortMembership  StudentCohortMembership?  @relation(fields: [studentCohortMembershipId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([sectionId])
  @@index([academicCycleId])
  @@index([studentProgramEnrollmentId])
  @@index([studentStageEnrollmentId])
  @@index([studentCohortMembershipId])
}

