  SKIPPED
  WITHDRAWN
}

enum StudentProgressionOutcome {
  ADVANCE
  REPEAT
  PAUSE
  TRANSFER
  COMPLETE
  WITHDRAW
  REMAIN
}

enum ProgressionBulkOperationStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum AcademicCycleArchiveStatus {
  BUILDING
  READY
  FAILED
}

enum ArchiveProgramSourceKind {
  COHORT_OFFERING
  SECTION_MAPPING
}

model Program {
  id                          String                 @id @default(uuid())
  organizationId              String
  departmentId                String
  name                        String
  code                        String
  description                 String?
  status                      ProgramStatus          @default(DRAFT)
  configurationVersion        Int                    @default(1)
  structureType               ProgramStructureType
  progressionMode             ProgramProgressionMode
  completionMode              ProgramCompletionMode
  minimumPassingPercentage    Float                  @default(50)
  minimumAttendancePercentage Float?
  durationValue               Int?
  durationUnit                ProgramDurationUnit?
  isVisibleForAdmissions      Boolean                @default(false)
  admissionsLabel             String?
  admissionsDescription       String?
  admissionsSortOrder         Int                    @default(0)
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  archivedAt                  DateTime?
  archivedById                String?
  archiveReason               String?

  organization           Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department             Department                     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  offerings              ProgramOffering[]
  configurationRevisions ProgramConfigurationRevision[]
  curriculumVersions     CurriculumVersion[]
  studentEnrollments     StudentProgramEnrollment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([departmentId])
  @@index([status])
  @@index([isVisibleForAdmissions, admissionsSortOrder])
}

model ProgramConfigurationRevision {
  id                    String   @id @default(uuid())
  organizationId        String
  programId             String
  version               Int
  configurationSnapshot Json
  checksum              String
  changeReason          String?
  createdById           String
  createdAt             DateTime @default(now())

  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program            Program                    @relation(fields: [programId], references: [id], onDelete: Restrict)
  curriculumVersions CurriculumVersion[]
  studentEnrollments StudentProgramEnrollment[]

  @@unique([programId, version])
  @@index([organizationId])
  @@index([programId])
  @@index([checksum])
}

model CurriculumVersion {
  id                             String           @id @default(uuid())
  organizationId                 String
  programId                      String
  programConfigurationRevisionId String
  name                           String
  code                           String
  effectiveFrom                  DateTime?
  effectiveTo                    DateTime?
  status                         CurriculumStatus @default(DRAFT)
  stageTerminology               String?
  isDefaultForAdmissions         Boolean          @default(false)
  policySnapshot                 Json?
  activatedAt                    DateTime?
  retiredAt                      DateTime?
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime         @updatedAt

  organization                 Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program                      Program                      @relation(fields: [programId], references: [id], onDelete: Restrict)
  programConfigurationRevision ProgramConfigurationRevision @relation(fields: [programConfigurationRevisionId], references: [id], onDelete: Restrict)
  stages                       ProgramStage[]
  offerings                    ProgramOffering[]
  studentEnrollments           StudentProgramEnrollment[]

  @@unique([programId, code])
  @@index([organizationId])
  @@index([programId, status])
  @@index([programConfigurationRevisionId])
}

model ProgramStage {
  id                  String   @id @default(uuid())
  organizationId      String
  curriculumVersionId String
  name                String
  code                String
  sequence            Int
  stageType           String?
  isOptional          Boolean  @default(false)
  minCredits          Float?
  expectedCredits     Float?
  completionRule      Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization              Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  curriculumVersion         CurriculumVersion            @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  courseRequirements        StageCourseRequirement[]
  offerings                 ProgramStageOffering[]
  entryProgramEnrollments   StudentProgramEnrollment[]   @relation("StudentProgramEnrollmentEntryStage")
  studentStageEnrollments   StudentStageEnrollment[]
  progressionDecisionSource StudentProgressionDecision[] @relation("ProgressionSourceStage")
  progressionDecisionTarget StudentProgressionDecision[] @relation("ProgressionTargetStage")

  @@unique([curriculumVersionId, code])
  @@unique([curriculumVersionId, sequence])
  @@index([organizationId])
}

model StageCourseRequirement {
  id                  String                @id @default(uuid())
  organizationId      String
  programStageId      String
  courseId            String
  requirementType     CourseRequirementType
  groupKey            String?
  minCourses          Int?
  minCredits          Float?
  sortOrder           Int                   @default(0)
  creditHoursSnapshot Float
  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  programStage    ProgramStage            @relation(fields: [programStageId], references: [id], onDelete: Restrict)
  course          Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  sectionMappings SectionProgramMapping[]

  @@index([organizationId])
  @@index([programStageId, sortOrder])
  @@index([courseId])
}

model ProgramOffering {
  id                  String                @id @default(uuid())
  organizationId      String
  programId           String
  curriculumVersionId String
  academicCycleId     String
  status              ProgramOfferingStatus @default(DRAFT)
  opensAt             DateTime?
  closesAt            DateTime?
  capacity            Int?
  notes               String?
  createdById         String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program           Program                @relation(fields: [programId], references: [id], onDelete: Restrict)
  curriculumVersion CurriculumVersion      @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  academicCycle     AcademicCycle          @relation(fields: [academicCycleId], references: [id], onDelete: Restrict)
  stageOfferings    ProgramStageOffering[]

  @@unique([programId, curriculumVersionId, academicCycleId])
  @@index([organizationId])
  @@index([academicCycleId, status])
  @@index([programId, status])
}

model ProgramStageOffering {
  id                String                     @id @default(uuid())
  organizationId    String
  programOfferingId String
  programStageId    String
  status            ProgramStageOfferingStatus @default(PLANNED)
  startsAt          DateTime?
  endsAt            DateTime?
  capacity          Int?
  createdById       String
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  organization              Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  programOffering           ProgramOffering              @relation(fields: [programOfferingId], references: [id], onDelete: Restrict)
  programStage              ProgramStage                 @relation(fields: [programStageId], references: [id], onDelete: Restrict)
  cohortOfferings           CohortOffering[]
  sectionMappings           SectionProgramMapping[]
  studentStageEnrollments   StudentStageEnrollment[]
  progressionTargets        StudentProgressionDecision[] @relation("ProgressionTargetOffering")
  progressionBulkOperations ProgressionBulkOperation[]

  @@unique([programOfferingId, programStageId])
  @@index([organizationId])
  @@index([programStageId, status])
}

model CohortOffering {
  id                     String               @id @default(uuid())
  organizationId         String
  cohortId               String
  academicCycleId        String
  programStageOfferingId String?
  status                 CohortOfferingStatus @default(PLANNED)
  capacity               Int?
  createdById            String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cohort               Cohort                    @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  academicCycle        AcademicCycle             @relation(fields: [academicCycleId], references: [id], onDelete: Restrict)
  programStageOffering ProgramStageOffering?     @relation(fields: [programStageOfferingId], references: [id], onDelete: Restrict)
  sections             CohortOfferingSection[]
  memberships          StudentCohortMembership[]
  stageEnrollments     StudentStageEnrollment[]

  @@unique([cohortId, academicCycleId])
  @@index([organizationId])
  @@index([academicCycleId, status])
  @@index([programStageOfferingId])
}

model CohortOfferingSection {
  id               String              @id @default(uuid())
  organizationId   String
  cohortOfferingId String
  sectionId        String
  source           CohortSectionSource @default(MANUAL)
  isDefault        Boolean             @default(true)
  createdById      String
  createdAt        DateTime            @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cohortOffering CohortOffering @relation(fields: [cohortOfferingId], references: [id], onDelete: Restrict)
  section        Section        @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([cohortOfferingId, sectionId])
  @@index([organizationId])
  @@index([sectionId])
}

model SectionProgramMapping {
  id                       String   @id @default(uuid())
  organizationId           String
  sectionId                String
  programStageOfferingId   String
  stageCourseRequirementId String
  createdById              String
  createdAt                DateTime @default(now())

  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  section                Section                @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  programStageOffering   ProgramStageOffering   @relation(fields: [programStageOfferingId], references: [id], onDelete: Restrict)
  stageCourseRequirement StageCourseRequirement @relation(fields: [stageCourseRequirementId], references: [id], onDelete: Restrict)

  @@unique([sectionId, programStageOfferingId, stageCourseRequirementId])
  @@index([organizationId])
  @@index([programStageOfferingId])
  @@index([stageCourseRequirementId])
}

model StudentProgramEnrollment {
  id                                  String                         @id @default(uuid())
  organizationId                      String
  studentId                           String
  programId                           String
  curriculumVersionId                 String
  programConfigurationRevisionId      String
  status                              StudentProgramEnrollmentStatus @default(ADMITTED)
  openSlot                            String?                        @unique
  requiredStageCountSnapshot          Int
  programConfigurationVersionSnapshot Int
  curriculumSnapshotHash              String
  progressionModeSnapshot             ProgramProgressionMode
  completionModeSnapshot              ProgramCompletionMode
  minimumPassingPercentageSnapshot    Float
  minimumAttendancePercentageSnapshot Float?
  entryStageId                        String?
  admittedAt                          DateTime                       @default(now())
  admittedById                        String
  startedAt                           DateTime?
  endedAt                             DateTime?
  endedById                           String?
  exitReason                          String?
  metadata                            Json?
  createdAt                           DateTime                       @default(now())
  updatedAt                           DateTime                       @updatedAt

  organization                 Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  student                      Student                      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  program                      Program                      @relation(fields: [programId], references: [id], onDelete: Restrict)
  curriculumVersion            CurriculumVersion            @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  programConfigurationRevision ProgramConfigurationRevision @relation(fields: [programConfigurationRevisionId], references: [id], onDelete: Restrict)
  entryStage                   ProgramStage?                @relation("StudentProgramEnrollmentEntryStage", fields: [entryStageId], references: [id], onDelete: Restrict)
  stageEnrollments             StudentStageEnrollment[]
  progressionDecisions         StudentProgressionDecision[]
  sectionEnrollments           Enrollment[]
  sectionEnrollmentHistories   EnrollmentHistory[]

  @@index([organizationId])
  @@index([studentId, status])
  @@index([programId])
  @@index([curriculumVersionId])
  @@index([programConfigurationRevisionId])
  @@index([entryStageId])
}

model StudentStageEnrollment {
  id                         String                       @id @default(uuid())
  organizationId             String
  studentProgramEnrollmentId String
  programStageId             String
  programStageOfferingId     String
  cohortOfferingId           String?
  attemptNumber              Int
  status                     StudentStageEnrollmentStatus @default(PLANNED)
  stageNameSnapshot          String
  stageCodeSnapshot          String
  cycleNameSnapshot          String
  cycleCodeSnapshot          String
  reason                     String?
  startedAt                  DateTime?
  completedAt                DateTime?
  resolvedById               String?
  resultSnapshot             Json?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  organization             Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentProgramEnrollment StudentProgramEnrollment     @relation(fields: [studentProgramEnrollmentId], references: [id], onDelete: Restrict)
  programStage             ProgramStage                 @relation(fields: [programStageId], references: [id], onDelete: Restrict)
  programStageOffering     ProgramStageOffering         @relation(fields: [programStageOfferingId], references: [id], onDelete: Restrict)
  cohortOffering           CohortOffering?              @relation(fields: [cohortOfferingId], references: [id], onDelete: Restrict)
  cohortMemberships        StudentCohortMembership[]
  progressionDecisions     StudentProgressionDecision[] @relation("ProgressionSourceEnrollment")
  sectionEnrollments       Enrollment[]
  sectionEnrollmentHistory EnrollmentHistory[]

  @@unique([studentProgramEnrollmentId, programStageOfferingId, attemptNumber])
  @@index([organizationId])
  @@index([programStageId, status])
  @@index([cohortOfferingId])
}

model StudentCohortMembership {
  id                       String           @id @default(uuid())
  organizationId           String
  studentId                String
  cohortOfferingId         String
  studentStageEnrollmentId String?
  source                   EnrollmentSource @default(MANUAL)
  reason                   String?
  joinedById               String
  joinedAt                 DateTime         @default(now())
  leftById                 String?
  leftAt                   DateTime?

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  student                Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  cohortOffering         CohortOffering          @relation(fields: [cohortOfferingId], references: [id], onDelete: Restrict)
  studentStageEnrollment StudentStageEnrollment? @relation(fields: [studentStageEnrollmentId], references: [id], onDelete: Restrict)
  sectionEnrollments     Enrollment[]
  sectionHistory         EnrollmentHistory[]

  @@index([organizationId])
  @@index([studentId, leftAt])
  @@index([cohortOfferingId, leftAt])
}

model StudentProgressionDecision {
  id                         String                    @id @default(uuid())
  organizationId             String
  studentProgramEnrollmentId String
  sourceStageEnrollmentId    String?
  sourceStageId              String?
  outcome                    StudentProgressionOutcome
  targetStageId              String?
  targetStageOfferingId      String?
  recommendationSnapshot     Json?
  resultSnapshot             Json?
  isOverride                 Boolean                   @default(false)
  idempotencyKey             String?
  reason                     String
  decidedById                String
  decidedAt                  DateTime                  @default(now())

  organization             Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentProgramEnrollment StudentProgramEnrollment @relation(fields: [studentProgramEnrollmentId], references: [id], onDelete: Restrict)
  sourceStageEnrollment    StudentStageEnrollment?  @relation("ProgressionSourceEnrollment", fields: [sourceStageEnrollmentId], references: [id], onDelete: Restrict)
  sourceStage              ProgramStage?            @relation("ProgressionSourceStage", fields: [sourceStageId], references: [id], onDelete: Restrict)
  targetStage              ProgramStage?            @relation("ProgressionTargetStage", fields: [targetStageId], references: [id], onDelete: Restrict)
  targetStageOffering      ProgramStageOffering?    @relation("ProgressionTargetOffering", fields: [targetStageOfferingId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([studentProgramEnrollmentId, decidedAt])
  @@index([sourceStageEnrollmentId])
  @@index([targetStageOfferingId])
}

model ProgressionBulkOperation {
  id                           String                         @id @default(uuid())
  organizationId               String
  idempotencyKey               String
  sourceProgramStageOfferingId String
  requestHash                  String
  status                       ProgressionBulkOperationStatus @default(RUNNING)
  result                       Json?
  failureReason                String?
  createdById                  String
  createdAt                    DateTime                       @default(now())
  completedAt                  DateTime?

  organization               Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceProgramStageOffering ProgramStageOffering @relation(fields: [sourceProgramStageOfferingId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([sourceProgramStageOfferingId])
}

model GradeAnswerbookAttachment {
  id             String   @id @default(uuid())
  organizationId String
  gradeId        String
  fileId         String   @unique
  uploadedById   String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  grade        Grade        @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  file         File         @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([gradeId])
}

model AcademicCycleArchive {
  id              String                     @id @default(uuid())
  organizationId  String
  academicCycleId String
  revision        Int
  status          AcademicCycleArchiveStatus @default(BUILDING)
  schemaVersion   Int
  cutoffAt        DateTime
  createdById     String
  createdAt       DateTime                   @default(now())
  completedAt     DateTime?
  failureReason   String?
  manifest        Json?
  recordCounts    Json?
  checksum        String?

  organization          Organization                              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  academicCycle         AcademicCycle                             @relation("AcademicCycleArchives", fields: [academicCycleId], references: [id], onDelete: Restrict)
  currentForCycle       AcademicCycle?                            @relation("CurrentAcademicCycleArchive")
  sections              AcademicCycleArchiveSection[]
  sectionProgramIndexes AcademicCycleArchiveSectionProgramIndex[]
  studentIndexes        AcademicCycleArchiveStudentIndex[]
  lockedFiles           File[]

  @@unique([academicCycleId, revision])
  @@index([organizationId])
  @@index([status])
}

model AcademicCycleArchiveSection {
  id                   String                      @id @default(uuid())
  organizationId       String
  archiveId            String
  sourceSectionId      String
  sourceDepartmentId   String?
  sourceCohortId       String?
  sourceCourseId       String
  classificationStatus ProgramClassificationStatus
  departmentLabel      String?
  cohortLabel          String?
  courseLabel          String
  sectionLabel         String
  normalizedSearchText String
  teacherUserIds       String[]                    @default([])
  sectionChecksum      String
  payload              Json
  createdAt            DateTime                    @default(now())

  organization   Organization                              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  archive        AcademicCycleArchive                      @relation(fields: [archiveId], references: [id], onDelete: Restrict)
  sourceSection  Section                                   @relation(fields: [sourceSectionId], references: [id], onDelete: Restrict)
  programIndexes AcademicCycleArchiveSectionProgramIndex[]
  studentIndexes AcademicCycleArchiveStudentIndex[]

  @@unique([archiveId, sourceSectionId])
  @@index([organizationId])
  @@index([sourceDepartmentId])
  @@index([sourceCohortId])
  @@index([sourceCourseId])
  @@index([normalizedSearchText])
  @@index([teacherUserIds], type: Gin)
}

model AcademicCycleArchiveSectionProgramIndex {
  id                             String                   @id @default(uuid())
  organizationId                 String
  archiveId                      String
  archiveSectionId               String
  sourceKind                     ArchiveProgramSourceKind
  sourceMappingId                String
  sourceProgramOfferingId        String
  sourceProgramStageOfferingId   String
  sourceProgramId                String
  sourceCurriculumVersionId      String
  sourceProgramStageId           String
  sourceStageCourseRequirementId String?
  departmentLabel                String
  programLabel                   String
  curriculumLabel                String
  stageLabel                     String
  createdAt                      DateTime                 @default(now())

  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  archive        AcademicCycleArchive        @relation(fields: [archiveId], references: [id], onDelete: Restrict)
  archiveSection AcademicCycleArchiveSection @relation(fields: [archiveSectionId], references: [id], onDelete: Restrict)

  @@unique([archiveSectionId, sourceKind, sourceMappingId])
  @@index([organizationId])
  @@index([archiveId, sourceProgramId])
  @@index([sourceProgramOfferingId])
  @@index([sourceProgramStageOfferingId])
  @@index([sourceCurriculumVersionId])
  @@index([sourceProgramStageId])
}

model AcademicCycleArchiveStudentIndex {
  id                   String        @id @default(uuid())
  organizationId       String
  archiveId            String
  archiveSectionId     String
  sourceStudentId      String
  studentName          String
  registrationNumber   String
  rollNumber           String
  studentStatus        StudentStatus
  normalizedSearchText String
  cohortLabel          String?
  sectionLabel         String
  createdAt            DateTime      @default(now())

  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  archive        AcademicCycleArchive        @relation(fields: [archiveId], references: [id], onDelete: Restrict)
  archiveSection AcademicCycleArchiveSection @relation(fields: [archiveSectionId], references: [id], onDelete: Restrict)
  sourceStudent  Student                     @relation(fields: [sourceStudentId], references: [id], onDelete: Restrict)

  @@unique([archiveSectionId, sourceStudentId])
  @@index([organizationId])
  @@index([archiveId])
  @@index([sourceStudentId])
  @@index([normalizedSearchText])
}

